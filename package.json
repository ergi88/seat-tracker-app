{
  "name": "seat-tracker-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Seat Tracker on the phone: the team's requests, statuses, listings and sales, read from the same Supabase as the Chrome extension.",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/sync-core.mjs --check && vite build",
    "preview": "vite preview",
    "sync-core": "node scripts/sync-core.mjs",
    "icons": "node scripts/icons.mjs",
    "test": "node scripts/sync-core.mjs --check && node --test tests/*.test.js"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "svelte": "^5.57.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^1.3.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "idb-keyval": "^6.3.0"
  }
}
